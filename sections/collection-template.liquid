{%- comment -%}
  sections/collection-template.liquid
{%- endcomment -%}

<div
  class="collection-page"
  data-section-id="{{ section.id }}"
  data-section-type="collection-template"
  data-collection="{{ collection.handle }}"
>
  {%- comment -%} Collection Header {%- endcomment -%}
  <div class="collection-header">
    <div class="collection-header__inner">
      {%- if collection.image -%}
        <div class="collection-header__image">
          <img
            src="{{ collection.image | image_url: width: 1200 }}"
            alt="{{ collection.title }}"
            class="collection-header__img"
            width="{{ collection.image.width }}"
            height="{{ collection.image.height }}"
            loading="eager"
          >
          <div class="collection-header__overlay"></div>
        </div>
      {%- endif -%}

      <div class="collection-header__content">
        <h1 class="collection-header__title">{{ collection.title }}</h1>
        {%- if collection.description != blank -%}
          <p class="collection-header__description">{{ collection.description }}</p>
        {%- endif -%}
        <p class="collection-header__count">
          {{ collection.products_count }}
          {{ collection.products_count | pluralize: 'product', 'products' }}
        </p>
      </div>
    </div>
  </div>

  {%- comment -%} Collection Grid {%- endcomment -%}
  <div class="collection-grid">
    <div class="collection-grid__inner">
      <collection-grid
        data-collection="{{ collection.handle }}"
        data-products='{{ collection.products_json }}'
        data-columns="{{ section.settings.columns }}"
        data-show-filters="{{ section.settings.show_filters }}"
        data-show-sort="{{ section.settings.show_sort }}"
      ></collection-grid>
    </div>
  </div>
</div>

<style>
  .collection-page {
    padding-top: 64px;
  }

  @media (min-width: 1024px) {
    .collection-page {
      padding-top: 80px;
    }
  }

  /* Collection Header */
  .collection-header {
    position: relative;
    overflow: hidden;
    background-color: var(--color-muted, #F5F5F4);
  }

  .collection-header__inner {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    padding: 4rem 1rem;
    text-align: center;
  }

  @media (min-width: 768px) {
    .collection-header__inner {
      min-height: 400px;
      padding: 5rem 2rem;
    }
  }

  .collection-header__image {
    position: absolute;
    inset: 0;
  }

  .collection-header__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .collection-header__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.1),
      rgba(0, 0, 0, 0.4)
    );
  }

  .collection-header__content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    color: var(--color-background, #FAFAF9);
  }

  .collection-header__title {
    font-family: var(--font-heading, serif);
    font-size: 2.5rem;
    font-weight: 600;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .collection-header__title {
      font-size: 3.5rem;
    }
  }

  .collection-header__description {
    margin-bottom: 1rem;
    opacity: 0.9;
  }

  .collection-header__count {
    font-size: 0.875rem;
    opacity: 0.8;
  }

  /* Collection Grid */
  .collection-grid {
    padding: 3rem 1rem;
  }

  @media (min-width: 768px) {
    .collection-grid {
      padding: 4rem 2rem;
    }
  }

  .collection-grid__inner {
    max-width: 1440px;
    margin: 0 auto;
  }
</style>

{% schema %}
{
  "name": "Collection Template",
  "tag": "section",
  "class": "section-collection",
  "settings": [
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row",
      "min": 2,
      "max": 4,
      "default": 3,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show Filters",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show Sort",
      "default": true
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image Ratio",
      "options": [
        { "value": "3/4", "label": "Portrait (3:4)" },
        { "value": "4/3", "label": "Landscape (4:3)" },
        { "value": "1/1", "label": "Square (1:1)" }
      ],
      "default": "3/4"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_quick_add",
      "label": "Show Quick Add",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Collection Template"
    }
  ]
}
{% endschema %}
