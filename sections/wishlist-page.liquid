{%- comment -%}
  sections/wishlist-page.liquid
{%- endcomment -%}

<div class="wishlist-page" data-section-id="{{ section.id }}">
  <div class="wishlist-page__header">
    <h1 class="wishlist-page__title">My Wishlist</h1>
    <p class="wishlist-page__subtitle">Items you've saved for later</p>
  </div>

  <div id="wishlist-page-content" class="wishlist-page__content">
    <div class="wishlist-page__empty" id="wishlist-empty">
      <svg class="wishlist-page__empty-icon" viewBox="0 0 24 24" fill="none">
        <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
      <h2 class="wishlist-page__empty-title">Your wishlist is empty</h2>
      <p class="wishlist-page__empty-text">Save items you love by clicking the heart icon on any product.</p>
      <a href="/collections/all" class="wishlist-page__button">Start Shopping</a>
    </div>

    <div class="wishlist-page__grid" id="wishlist-grid" style="display: none;"></div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const WISHLIST_KEY = 'kenz-wishlist';
    const grid = document.getElementById('wishlist-grid');
    const emptyState = document.getElementById('wishlist-empty');

    function getWishlist() {
      try {
        const stored = localStorage.getItem(WISHLIST_KEY);
        return stored ? JSON.parse(stored) : [];
      } catch {
        return [];
      }
    }

    function renderWishlist() {
      const items = getWishlist();

      if (items.length === 0) {
        emptyState.style.display = 'flex';
        grid.style.display = 'none';
        return;
      }

      emptyState.style.display = 'none';
      grid.style.display = 'grid';

      grid.innerHTML = items.map(item => `
        <div class="wishlist-page__item" data-product-id="${item.id}">
          <a href="/products/${item.handle}" class="wishlist-page__item-image">
            <img src="${item.image}" alt="${item.title}" loading="lazy">
          </a>
          <div class="wishlist-page__item-info">
            ${item.vendor ? `<p class="wishlist-page__item-vendor">${item.vendor}</p>` : ''}
            <h3 class="wishlist-page__item-title">
              <a href="/products/${item.handle}">${item.title}</a>
            </h3>
            <p class="wishlist-page__item-price">$${item.price}</p>
            <div class="wishlist-page__item-actions">
              ${item.available ? `
                <button class="wishlist-page__add-to-cart" onclick="addToCart(${item.id})">
                  Add to Cart
                </button>
              ` : `
                <span class="wishlist-page__sold-out">Sold Out</span>
              `}
              <button class="wishlist-page__remove" onclick="removeFromWishlist(${item.id})">
                Remove
              </button>
            </div>
          </div>
        </div>
      `).join('');
    }

    window.addToCart = function(variantId) {
      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
      })
      .then(response => response.json())
      .then(() => {
        document.dispatchEvent(new CustomEvent('cart:refresh'));
        document.dispatchEvent(new CustomEvent('cart:open'));
      });
    };

    window.removeFromWishlist = function(productId) {
      const items = getWishlist().filter(item => item.id !== productId);
      localStorage.setItem(WISHLIST_KEY, JSON.stringify(items));
      renderWishlist();
    };

    renderWishlist();
  });
</script>

<style>
  .wishlist-page {
    padding: 120px 1rem 4rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .wishlist-page__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .wishlist-page__title {
    font-family: var(--font-heading, serif);
    font-size: 2.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .wishlist-page__subtitle {
    color: var(--color-muted, #78716C);
  }

  .wishlist-page__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 1rem;
    text-align: center;
  }

  .wishlist-page__empty-icon {
    width: 64px;
    height: 64px;
    color: var(--color-muted, #78716C);
    margin-bottom: 1rem;
  }

  .wishlist-page__empty-title {
    font-size: 1.25rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .wishlist-page__empty-text {
    color: var(--color-muted, #78716C);
    margin-bottom: 1.5rem;
    max-width: 300px;
  }

  .wishlist-page__button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: var(--color-foreground, #0C0A09);
    color: var(--color-background, #FAFAF9);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .wishlist-page__button:hover {
    opacity: 0.9;
  }

  .wishlist-page__grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 1.5rem;
  }

  @media (min-width: 640px) {
    .wishlist-page__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .wishlist-page__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .wishlist-page__item {
    display: flex;
    flex-direction: column;
    background: white;
    border: 1px solid var(--color-border, #E7E5E4);
  }

  .wishlist-page__item-image {
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--color-muted, #F5F5F4);
  }

  .wishlist-page__item-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .wishlist-page__item-image:hover img {
    transform: scale(1.05);
  }

  .wishlist-page__item-info {
    padding: 1rem;
  }

  .wishlist-page__item-vendor {
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted, #78716C);
    margin-bottom: 0.25rem;
  }

  .wishlist-page__item-title {
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .wishlist-page__item-title a {
    color: inherit;
    text-decoration: none;
  }

  .wishlist-page__item-title a:hover {
    color: var(--color-accent, #CA8A04);
  }

  .wishlist-page__item-price {
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .wishlist-page__item-actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .wishlist-page__add-to-cart {
    flex: 1;
    padding: 0.625rem;
    background-color: var(--color-foreground, #0C0A09);
    color: var(--color-background, #FAFAF9);
    border: none;
    font-size: 0.75rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .wishlist-page__add-to-cart:hover {
    opacity: 0.9;
  }

  .wishlist-page__sold-out {
    flex: 1;
    padding: 0.625rem;
    background-color: var(--color-muted, #F5F5F4);
    color: var(--color-muted, #78716C);
    font-size: 0.75rem;
    font-weight: 500;
    text-align: center;
  }

  .wishlist-page__remove {
    padding: 0.625rem;
    background: none;
    border: none;
    font-size: 0.75rem;
    color: var(--color-muted, #78716C);
    cursor: pointer;
    transition: color 0.2s;
  }

  .wishlist-page__remove:hover {
    color: #DC2626;
  }
</style>

{% schema %}
{
  "name": "Wishlist Page",
  "tag": "section",
  "class": "section-wishlist",
  "settings": [],
  "presets": [
    {
      "name": "Wishlist Page"
    }
  ]
}
{% endschema %}
