{%- comment -%}
  main/account.liquid
{%- endcomment -%}

<div class="account-page">
  <div class="account-page__inner">
    <div class="account-page__header">
      <h1 class="account-page__title">My Account</h1>
    </div>

    <div class="account-page__content">
      {%- comment -%} Account Navigation {%- endcomment -%}
      <nav class="account-nav">
        <ul class="account-nav__list">
          <li class="account-nav__item">
            <a href="/account" class="account-nav__link {% if template == 'customers/account' %}account-nav__link--active{% endif %}">
              <svg class="account-nav__icon" viewBox="0 0 24 24" fill="none">
                <path d="M20 21V19C20 16.7909 18.2091 15 16 15H8C5.79086 15 4 16.7909 4 19V21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="7" r="4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Account Details
            </a>
          </li>
          <li class="account-nav__item">
            <a href="/account/orders" class="account-nav__link {% if template == 'customers/order' or template == 'customers/account' %}account-nav__link--active{% endif %}">
              <svg class="account-nav__icon" viewBox="0 0 24 24" fill="none">
                <path d="M9 5H7C5.89543 5 5 5.89543 5 7V19C5 20.1046 5.89543 21 7 21H17C18.1046 21 19 20.1046 19 19V7C19 5.89543 18.1046 5 17 5H15" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <rect x="9" y="3" width="6" height="4" rx="1" stroke="currentColor" stroke-width="1.5"/>
              </svg>
              Orders
            </a>
          </li>
          <li class="account-nav__item">
            <a href="/account/addresses" class="account-nav__link">
              <svg class="account-nav__icon" viewBox="0 0 24 24" fill="none">
                <path d="M21 10C21 17 12 23 12 23C12 23 3 17 3 10C3 5 7 1 12 1C17 1 21 5 21 10Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="12" cy="10" r="3" stroke="currentColor" stroke-width="1.5"/>
              </svg>
              Addresses
            </a>
          </li>
          <li class="account-nav__item">
            <a href="/pages/wishlist" class="account-nav__link">
              <svg class="account-nav__icon" viewBox="0 0 24 24" fill="none">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Wishlist
            </a>
          </li>
        </ul>
      </nav>

      {%- comment -%} Account Details {%- endcomment -%}
      <div class="account-details">
        <h2 class="account-details__title">Account Details</h2>

        <div class="account-details__info">
          <div class="account-details__field">
            <span class="account-details__label">Name</span>
            <span class="account-details__value">{{ customer.name }}</span>
          </div>
          <div class="account-details__field">
            <span class="account-details__label">Email</span>
            <span class="account-details__value">{{ customer.email }}</span>
          </div>
          {%- if customer.default_address -%}
            <div class="account-details__field">
              <span class="account-details__label">Default Address</span>
              <span class="account-details__value">
                {{ customer.default_address.street }}<br>
                {{ customer.default_address.city }}, {{ customer.default_address.province_code }} {{ customer.default_address.zip }}<br>
                {{ customer.default_address.country }}
              </span>
            </div>
          {%- endif -%}
        </div>

        <div class="account-details__actions">
          <a href="/account/addresses" class="account-details__button">Edit Addresses</a>
          <form method="post" action="/account/logout">
            <button type="submit" class="account-details__button account-details__button--secondary">
              Sign Out
            </button>
          </form>
        </div>
      </div>

      {%- comment -%} Recent Orders {%- endcomment -%}
      {%- if customer.orders.size > 0 -%}
        <div class="account-orders">
          <div class="account-orders__header">
            <h2 class="account-orders__title">Recent Orders</h2>
            <a href="/account/orders" class="account-orders__view-all">View All</a>
          </div>

          <div class="account-orders__list">
            {%- for order in customer.orders limit:5 -%}
              <div class="account-order">
                <div class="account-order__info">
                  <span class="account-order__number">{{ order.name }}</span>
                  <span class="account-order__date">{{ order.created_at | date: "%B %d, %Y" }}</span>
                </div>
                <div class="account-order__status">
                  <span class="account-order__status-badge account-order__status-badge--{{ order.financial_status }}">
                    {{ order.financial_status_label }}
                  </span>
                </div>
                <div class="account-order__total">
                  {{ order.total_price | money }}
                </div>
                <a href="{{ order.customer_url }}" class="account-order__link">
                  View Order
                  <svg class="account-order__arrow" viewBox="0 0 24 24" fill="none">
                    <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </a>
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .account-page {
    padding: 120px 1rem 4rem;
  }

  .account-page__inner {
    max-width: 1000px;
    margin: 0 auto;
  }

  .account-page__header {
    margin-bottom: 3rem;
    text-align: center;
  }

  .account-page__title {
    font-family: var(--font-heading, serif);
    font-size: 2.5rem;
    font-weight: 600;
  }

  .account-page__content {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .account-page__content {
      grid-template-columns: 250px 1fr;
      gap: 4rem;
    }
  }

  /* Account Navigation */
  .account-nav__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
  }

  @media (min-width: 768px) {
    .account-nav__list {
      flex-direction: column;
      overflow-x: visible;
    }
  }

  .account-nav__link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    color: var(--color-muted, #78716C);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    border-radius: 0.375rem;
    transition: all 0.2s;
    white-space: nowrap;
  }

  .account-nav__link:hover {
    color: var(--color-foreground, #0C0A09);
    background-color: var(--color-muted, #F5F5F4);
  }

  .account-nav__link--active {
    color: var(--color-foreground, #0C0A09);
    background-color: var(--color-muted, #F5F5F4);
  }

  .account-nav__icon {
    width: 18px;
    height: 18px;
  }

  /* Account Details */
  .account-details {
    background: white;
    border: 1px solid var(--color-border, #E7E5E4);
    padding: 2rem;
  }

  .account-details__title {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border, #E7E5E4);
  }

  .account-details__info {
    display: grid;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .account-details__field {
    display: grid;
    gap: 0.25rem;
  }

  .account-details__label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-muted, #78716C);
  }

  .account-details__value {
    font-size: 0.875rem;
  }

  .account-details__actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .account-details__button {
    padding: 0.625rem 1.25rem;
    background-color: var(--color-foreground, #0C0A09);
    color: var(--color-background, #FAFAF9);
    border: none;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .account-details__button:hover {
    opacity: 0.9;
  }

  .account-details__button--secondary {
    background-color: transparent;
    color: var(--color-muted, #78716C);
    border: 1px solid var(--color-border, #E7E5E4);
  }

  .account-details__button--secondary:hover {
    color: var(--color-foreground, #0C0A09);
    border-color: var(--color-foreground, #0C0A09);
  }

  /* Account Orders */
  .account-orders {
    background: white;
    border: 1px solid var(--color-border, #E7E5E4);
    padding: 2rem;
  }

  .account-orders__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border, #E7E5E4);
  }

  .account-orders__title {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .account-orders__view-all {
    font-size: 0.875rem;
    color: var(--color-accent, #CA8A04);
    text-decoration: none;
  }

  .account-orders__view-all:hover {
    text-decoration: underline;
  }

  .account-orders__list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .account-order {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    padding: 1rem;
    background: var(--color-muted, #F5F5F4);
    align-items: center;
  }

  @media (min-width: 640px) {
    .account-order {
      grid-template-columns: 1fr auto auto auto;
    }
  }

  .account-order__info {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .account-order__number {
    font-weight: 500;
  }

  .account-order__date {
    font-size: 0.75rem;
    color: var(--color-muted, #78716C);
  }

  .account-order__status-badge {
    display: inline-block;
    padding: 0.25rem 0.5rem;
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 0.25rem;
  }

  .account-order__status-badge--paid {
    background-color: #D1FAE5;
    color: #065F46;
  }

  .account-order__status-badge--pending {
    background-color: #FEF3C7;
    color: #92400E;
  }

  .account-order__status-badge--refunded {
    background-color: #FEE2E2;
    color: #991B1B;
  }

  .account-order__total {
    font-weight: 500;
    text-align: right;
  }

  @media (min-width: 640px) {
    .account-order__total {
      text-align: left;
    }
  }

  .account-order__link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.875rem;
    color: var(--color-accent, #CA8A04);
    text-decoration: none;
    grid-column: 1 / -1;
  }

  @media (min-width: 640px) {
    .account-order__link {
      grid-column: auto;
    }
  }

  .account-order__link:hover {
    text-decoration: underline;
  }

  .account-order__arrow {
    width: 14px;
    height: 14px;
  }
</style>

{% schema %}
{
  "name": "Account Page",
  "tag": "section",
  "class": "section-account",
  "settings": [],
  "presets": [
    {
      "name": "Account Page"
    }
  ]
}
{% endschema %}
