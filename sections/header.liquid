<header
  class="sticky top-0 z-40 border-b border-border/50 bg-background/90 backdrop-blur-xl transition-shadow duration-300"
  id="Header-{{ section.id }}"
>
  <div class="mx-auto flex h-[60px] max-w-7xl items-center justify-between px-6">
    <!-- Left Navigation (Desktop) -->
    <nav class="hidden flex-1 items-center gap-7 text-[13px] font-light tracking-wide md:flex" aria-label="Primary">
      {%- for link in linklists[section.settings.menu].links -%}
        <div class="group relative py-4">
          <a
            href="{{ link.url }}"
            class="text-foreground/65 hover:text-accent transition-colors duration-200 py-2 cursor-pointer font-light tracking-wide"
          >
            {{ link.title }}
          </a>
          
          {%- if link.links != blank -%}
            <!-- Mega Menu Panel -->
            <div class="absolute left-[-150px] top-full z-50 hidden group-hover:block border-b border-border/50 bg-background/95 backdrop-blur-xl shadow-[0_24px_48px_-20px_rgba(28,25,23,0.18)] min-w-[700px] p-10 transition-all duration-300">
              <div class="grid grid-cols-12 gap-10">
                <!-- Feature column -->
                <div class="col-span-5">
                  {%- assign feat_collection = link.object -%}
                  {%- assign feat_image = feat_collection.featured_image | default: section.settings.fallback_feature_image -%}
                  <div class="overflow-hidden bg-secondary">
                    {%- if feat_image != blank -%}
                      <img
                        src="{{ feat_image | image_url: width: 500 }}"
                        alt="{{ link.title }}"
                        loading="lazy"
                        class="aspect-[4/3] w-full object-cover transition-transform duration-700 hover:scale-[1.04]"
                      >
                    {%- else -%}
                      <div class="aspect-[4/3] w-full bg-neutral-200 flex items-center justify-center text-muted-foreground">
                        No Image
                      </div>
                    {%- endif -%}
                  </div>
                  <div class="mt-4 flex items-center justify-between">
                    <div>
                      <div class="text-[10px] uppercase tracking-[0.26em] text-accent">Featured</div>
                      <div class="mt-1 font-display text-xl font-light">{{ link.title }} Edit</div>
                    </div>
                    <a
                      href="{{ link.url }}"
                      class="inline-flex items-center gap-1.5 text-[12px] uppercase tracking-[0.16em] text-foreground/60 hover:text-accent transition-colors duration-200"
                    >
                      Shop &rarr;
                    </a>
                  </div>
                </div>
                
                <!-- Links columns -->
                <div class="col-span-7 grid grid-cols-3 gap-8">
                  {%- for sub_link in link.links -%}
                    <div>
                      <h4 class="text-[10px] font-medium uppercase tracking-[0.24em] text-muted-foreground">
                        {{ sub_link.title }}
                      </h4>
                      <ul class="mt-5 space-y-3">
                        {%- for grandchild_link in sub_link.links -%}
                          <li>
                            <a
                              href="{{ grandchild_link.url }}"
                              class="text-[13px] font-light text-foreground/70 transition-colors duration-200 hover:text-accent"
                            >
                              {{ grandchild_link.title }}
                            </a>
                          </li>
                        {%- else -%}
                          <!-- If no grandchildren, link to sub_link itself -->
                          <li>
                            <a
                              href="{{ sub_link.url }}"
                              class="text-[13px] font-light text-foreground/70 transition-colors duration-200 hover:text-accent"
                            >
                              All {{ sub_link.title }}
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  {%- endfor -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </nav>

    <!-- Mobile Burger Menu -->
    <button
      type="button"
      class="md:hidden text-foreground/70 hover:text-foreground transition-colors cursor-pointer"
      onclick="document.getElementById('MobileMenuDrawer').classList.remove('hidden')"
      aria-label="Open navigation menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
    </button>

    <!-- Center Brand Mark -->
    <div class="absolute left-1/2 -translate-x-1/2">
      <a href="/" class="group flex items-center gap-0 select-none cursor-pointer">
        <span class="font-display text-[22px] tracking-[0.16em] uppercase text-foreground transition-opacity duration-300 group-hover:opacity-80" style="font-weight: 500; letter-spacing: 0.18em;">
          K<span class="text-accent">ENZ</span>
        </span>
        <span class="ml-2.5 mt-[3px] hidden text-[9px] tracking-[0.28em] uppercase text-muted-foreground sm:block" style="letter-spacing: 0.3em;">
          Maison
        </span>
      </a>
    </div>

    <!-- Right Icons -->
    <div class="flex flex-1 items-center justify-end gap-4 text-foreground/70">
      <!-- Search Trigger -->
      <button
        aria-label="Search"
        on:click="#search-modal/showDialog"
        aria-haspopup="dialog"
        class="hover:text-foreground transition-colors duration-200 cursor-pointer p-1"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-[17px] w-[17px]"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
      </button>

      <!-- Wishlist Link -->
      <a
        href="/pages/wishlist"
        aria-label="Wishlist"
        class="relative hidden hover:text-foreground transition-colors duration-200 sm:block p-1"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-[17px] w-[17px]"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"></path></svg>
      </a>

      <!-- Account Link -->
      <a
        href="/account"
        aria-label="My account"
        class="hidden hover:text-foreground transition-colors duration-200 sm:block p-1"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-[17px] w-[17px]"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
      </a>

      <!-- Cart Drawer Trigger -->
      <button
        aria-label="Shopping bag"
        on:click="#cart-drawer/toggle"
        aria-controls="cart-drawer"
        aria-haspopup="dialog"
        class="relative hover:text-foreground transition-colors duration-200 cursor-pointer p-1"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-[17px] w-[17px]"><path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"></path><line x1="3" y1="6" x2="21" y2="6"></line><path d="M16 10a4 4 0 0 1-8 0"></path></svg>
        <span class="absolute -right-1.5 -top-1.5 flex h-[14px] min-w-[14px] items-center justify-center rounded-full bg-accent px-[3px] text-[9px] font-medium text-accent-foreground leading-none {% if cart.item_count == 0 %}hidden{% endif %}" id="CartCountBadge">
          {{ cart.item_count }}
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Menu Drawer Overlay -->
<div id="MobileMenuDrawer" class="fixed inset-0 z-50 bg-background hidden md:hidden flex flex-col">
  <!-- Mobile header -->
  <div class="flex items-center justify-between border-b border-border/50 px-6 py-4">
    <a href="/" class="group flex items-center gap-0 select-none cursor-pointer">
      <span class="font-display text-[22px] tracking-[0.16em] uppercase text-foreground">
        K<span class="text-accent">ENZ</span>
      </span>
      <span class="ml-2.5 mt-[3px] text-[9px] tracking-[0.28em] uppercase text-muted-foreground">
        Maison
      </span>
    </a>
    <button
      type="button"
      onclick="document.getElementById('MobileMenuDrawer').classList.add('hidden')"
      aria-label="Close menu"
      class="text-foreground/70 hover:text-foreground transition-colors cursor-pointer"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>
  </div>

  <!-- Mobile nav -->
  <nav class="flex-1 overflow-y-auto px-6 py-8 space-y-8" aria-label="Mobile navigation">
    {%- for link in linklists[section.settings.menu].links -%}
      <div>
        <div class="font-display text-3xl font-light text-foreground">{{ link.title }}</div>
        {%- if link.links != blank -%}
          <ul class="mt-3 space-y-2.5 pl-0.5">
            {%- for sub_link in link.links -%}
              <li>
                <a
                  href="{{ sub_link.url }}"
                  onclick="document.getElementById('MobileMenuDrawer').classList.add('hidden')"
                  class="text-[15px] text-foreground/65 hover:text-accent transition-colors duration-200"
                >
                  {{ sub_link.title }}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    {%- endfor -%}

    <!-- Flat links + account -->
    <div class="space-y-4 border-t border-border/50 pt-7">
      <a
        href="/pages/wishlist"
        onclick="document.getElementById('MobileMenuDrawer').classList.add('hidden')"
        class="block font-display text-2xl font-light text-foreground hover:text-accent transition-colors duration-200"
      >
        Wishlist
      </a>
      <a
        href="/account"
        onclick="document.getElementById('MobileMenuDrawer').classList.add('hidden')"
        class="block font-display text-2xl font-light text-foreground hover:text-accent transition-colors duration-200"
      >
        Account
      </a>
    </div>
  </nav>

  <!-- Mobile footer strip -->
  <div class="border-t border-border/50 px-6 py-5 flex items-center gap-6 text-[11px] uppercase tracking-[0.2em] text-muted-foreground">
    <a href="#" class="hover:text-accent transition-colors">EN</a>
    <a href="#" class="hover:text-accent transition-colors">USD</a>
    <a href="/apps/track-order" class="hover:text-accent transition-colors">Track Order</a>
  </div>
</div>

<script>
  // Dynamically listen to Shopify cart events to update badge
  document.addEventListener('cart:updated', (event) => {
    const badge = document.getElementById('CartCountBadge');
    if (badge && event.detail && typeof event.detail.item_count !== 'undefined') {
      badge.textContent = event.detail.item_count;
      if (event.detail.item_count > 0) {
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }
    }
  });
</script>

{% schema %}
{
  "name": "Header (KENZ Maison)",
  "tag": "section",
  "class": "shopify-section-header-kenz",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu"
    },
    {
      "type": "image_picker",
      "id": "fallback_feature_image",
      "label": "Fallback Feature Image (for Mega Menu)"
    }
  ],
  "presets": [
    {
      "name": "Header (KENZ Maison)"
    }
  ]
}
{% endschema %}
