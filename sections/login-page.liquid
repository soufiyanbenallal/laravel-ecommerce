{%- comment -%}
  main/login.liquid
{%- endcomment -%}

<div class="login-page">
  <div class="login-page__inner">
    {%- comment -%} Login Form {%- endcomment -%}
    <div class="login-form" id="customer_login">
      <div class="login-form__header">
        <h1 class="login-form__title">Sign In</h1>
        <p class="login-form__subtitle">
          Don't have an account?
          <a href="/account/register" class="login-form__link">Create one</a>
        </p>
      </div>

      {%- form 'customer_login' -%}
        {%- if form.errors -%}
          <div class="login-form__errors">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="login-form__field">
          <label for="CustomerEmail" class="login-form__label">Email</label>
          <input
            type="email"
            name="customer[email]"
            id="CustomerEmail"
            class="login-form__input"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            {%- if form.errors -%}
              aria-invalid="true"
            {%- endif -%}
          >
        </div>

        <div class="login-form__field">
          <label for="CustomerPassword" class="login-form__label">Password</label>
          <input
            type="password"
            name="customer[password]"
            id="CustomerPassword"
            class="login-form__input"
            autocomplete="current-password"
            required
            {%- if form.errors -%}
              aria-invalid="true"
            {%- endif -%}
          >
        </div>

        <div class="login-form__options">
          <label class="login-form__remember">
            <input type="checkbox" name="remember" value="1">
            <span>Remember me</span>
          </label>
          <a href="/account/recover" class="login-form__forgot">Forgot password?</a>
        </div>

        <button type="submit" class="login-form__button">
          Sign In
        </button>
      {%- endform -%}

      <div class="login-form__divider">
        <span>or</span>
      </div>

      <a href="/account" class="login-form__guest">
        Continue as Guest
      </a>
    </div>

    {%- comment -%} Recover Password Form {%- endcomment -%}
    <div class="login-form" id="recover_password" style="display: none;">
      <div class="login-form__header">
        <h1 class="login-form__title">Reset Password</h1>
        <p class="login-form__subtitle">
          We'll send you an email to reset your password.
        </p>
      </div>

      {%- form 'recover_customer_password' -%}
        {%- if form.posted_successfully? -%}
          <div class="login-form__success">
            We've sent you an email with a link to reset your password.
          </div>
        {%- endif -%}

        {%- if form.errors -%}
          <div class="login-form__errors">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="login-form__field">
          <label for="RecoverEmail" class="login-form__label">Email</label>
          <input
            type="email"
            name="email"
            id="RecoverEmail"
            class="login-form__input"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
          >
        </div>

        <button type="submit" class="login-form__button">
          Reset Password
        </button>
      {%- endform -%}

      <div class="login-form__back">
        <button type="button" class="login-form__link" onclick="document.getElementById('recover_password').style.display='none'; document.getElementById('customer_login').style.display='block';">
          ← Back to Sign In
        </button>
      </div>
    </div>
  </div>
</div>

<style>
  .login-page {
    padding: 120px 1rem 4rem;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-muted, #F5F5F4);
  }

  .login-page__inner {
    width: 100%;
    max-width: 420px;
  }

  .login-form {
    background: white;
    padding: 2.5rem;
    border: 1px solid var(--color-border, #E7E5E4);
  }

  .login-form__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .login-form__title {
    font-family: var(--font-heading, serif);
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .login-form__subtitle {
    font-size: 0.875rem;
    color: var(--color-muted, #78716C);
  }

  .login-form__link {
    color: var(--color-accent, #CA8A04);
    text-decoration: none;
    font-weight: 500;
    cursor: pointer;
    background: none;
    border: none;
    font-size: inherit;
  }

  .login-form__link:hover {
    text-decoration: underline;
  }

  .login-form__errors {
    margin-bottom: 1.5rem;
    padding: 1rem;
    background-color: #FEE2E2;
    border: 1px solid #FECACA;
    color: #991B1B;
    font-size: 0.875rem;
  }

  .login-form__success {
    margin-bottom: 1.5rem;
    padding: 1rem;
    background-color: #D1FAE5;
    border: 1px solid #A7F3D0;
    color: #065F46;
    font-size: 0.875rem;
  }

  .login-form__field {
    margin-bottom: 1.25rem;
  }

  .login-form__label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .login-form__input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border, #E7E5E4);
    font-size: 0.875rem;
    transition: border-color 0.2s;
  }

  .login-form__input:focus {
    outline: none;
    border-color: var(--color-accent, #CA8A04);
  }

  .login-form__input[aria-invalid="true"] {
    border-color: #DC2626;
  }

  .login-form__options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }

  .login-form__remember {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    cursor: pointer;
  }

  .login-form__forgot {
    color: var(--color-muted, #78716C);
    text-decoration: none;
  }

  .login-form__forgot:hover {
    color: var(--color-foreground, #0C0A09);
    text-decoration: underline;
  }

  .login-form__button {
    width: 100%;
    padding: 0.875rem;
    background-color: var(--color-foreground, #0C0A09);
    color: var(--color-background, #FAFAF9);
    border: none;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .login-form__button:hover {
    opacity: 0.9;
  }

  .login-form__divider {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin: 1.5rem 0;
    color: var(--color-muted, #78716C);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .login-form__divider::before,
  .login-form__divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background-color: var(--color-border, #E7E5E4);
  }

  .login-form__guest {
    display: block;
    width: 100%;
    padding: 0.875rem;
    background-color: transparent;
    color: var(--color-muted, #78716C);
    border: 1px solid var(--color-border, #E7E5E4);
    font-size: 0.875rem;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    transition: all 0.2s;
  }

  .login-form__guest:hover {
    color: var(--color-foreground, #0C0A09);
    border-color: var(--color-foreground, #0C0A09);
  }

  .login-form__back {
    margin-top: 1.5rem;
    text-align: center;
  }
</style>

{% schema %}
{
  "name": "Login Page",
  "tag": "section",
  "class": "section-login",
  "settings": [],
  "presets": [
    {
      "name": "Login Page"
    }
  ]
}
{% endschema %}
