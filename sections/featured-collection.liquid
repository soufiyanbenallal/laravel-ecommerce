{%- comment -%}
  sections/featured-collection.liquid
{%- endcomment -%}

<div
  class="featured-collection"
  data-section-id="{{ section.id }}"
  data-section-type="featured-collection"
>
  <div class="featured-collection__inner">
    {%- if section.settings.title != blank -%}
      <div class="featured-collection__header">
        <h2 class="featured-collection__title">{{ section.settings.title }}</h2>
        {%- if section.settings.collection != blank -%}
          <a href="{{ section.settings.collection.url }}" class="featured-collection__view-all">
            View All
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.collection != blank -%}
      <div class="featured-collection__grid">
        {%- for product in section.settings.collection.products limit: section.settings.limit -%}
          <div class="featured-collection__item">
            <a href="{{ product.url }}" class="featured-collection__image-link">
              {%- if product.featured_image -%}
                <img
                  class="featured-collection__image"
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | default: product.title }}"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                  loading="lazy"
                >
              {%- endif -%}
            </a>
            <div class="featured-collection__info">
              <h3 class="featured-collection__product-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              <p class="featured-collection__price">{{ product.price | money }}</p>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="featured-collection__empty">
        <p>Select a collection in the section settings</p>
      </div>
    {%- endif -%}
  </div>
</div>

<style>
  .featured-collection {
    padding: 4rem 1.5rem;
  }

  @media (min-width: 768px) {
    .featured-collection {
      padding: 6rem 3rem;
    }
  }

  .featured-collection__inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .featured-collection__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .featured-collection__title {
    font-family: var(--font-heading, serif);
    font-size: 2rem;
    font-weight: 600;
  }

  .featured-collection__view-all {
    font-size: 0.875rem;
    color: var(--color-accent, #CA8A04);
    text-decoration: none;
  }

  .featured-collection__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .featured-collection__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .featured-collection__image-link {
    display: block;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--color-muted, #F5F5F4);
    margin-bottom: 1rem;
  }

  .featured-collection__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .featured-collection__image-link:hover .featured-collection__image {
    transform: scale(1.05);
  }

  .featured-collection__product-title {
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .featured-collection__product-title a {
    color: inherit;
    text-decoration: none;
  }

  .featured-collection__product-title a:hover {
    color: var(--color-accent, #CA8A04);
  }

  .featured-collection__price {
    font-size: 0.875rem;
    font-weight: 500;
  }

  .featured-collection__empty {
    text-align: center;
    padding: 4rem;
    color: var(--color-muted, #78716C);
  }
</style>

{% schema %}
{
  "name": "Featured Collection",
  "tag": "section",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Featured Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "default": 4,
      "step": 1
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
