{%- comment -%}
  main/register.liquid
{%- endcomment -%}

<div class="register-page">
  <div class="register-page__inner">
    <div class="register-form">
      <div class="register-form__header">
        <h1 class="register-form__title">Create Account</h1>
        <p class="register-form__subtitle">
          Already have an account?
          <a href="/account/login" class="register-form__link">Sign in</a>
        </p>
      </div>

      {%- form 'create_customer' -%}
        {%- if form.errors -%}
          <div class="register-form__errors">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        <div class="register-form__row">
          <div class="register-form__field">
            <label for="FirstName" class="register-form__label">First Name</label>
            <input
              type="text"
              name="customer[first_name]"
              id="FirstName"
              class="register-form__input"
              autocomplete="given-name"
              required
            >
          </div>

          <div class="register-form__field">
            <label for="LastName" class="register-form__label">Last Name</label>
            <input
              type="text"
              name="customer[last_name]"
              id="LastName"
              class="register-form__input"
              autocomplete="family-name"
              required
            >
          </div>
        </div>

        <div class="register-form__field">
          <label for="Email" class="register-form__label">Email</label>
          <input
            type="email"
            name="customer[email]"
            id="Email"
            class="register-form__input"
            autocomplete="email"
            autocorrect="off"
            autocapitalize="off"
            required
            {%- if form.errors contains 'email' -%}
              aria-invalid="true"
            {%- endif -%}
          >
        </div>

        <div class="register-form__field">
          <label for="CreatePassword" class="register-form__label">Password</label>
          <input
            type="password"
            name="customer[password]"
            id="CreatePassword"
            class="register-form__input"
            autocomplete="new-password"
            required
            {%- if form.errors contains 'password' -%}
              aria-invalid="true"
            {%- endif -%}
          >
          <p class="register-form__hint">Must be at least 8 characters</p>
        </div>

        <div class="register-form__consent">
          <label class="register-form__checkbox">
            <input type="checkbox" name="customer[accepts_marketing]" value="1" checked>
            <span>Subscribe to our newsletter for updates and exclusive offers</span>
          </label>
        </div>

        <button type="submit" class="register-form__button">
          Create Account
        </button>
      {%- endform -%}

      <div class="register-form__terms">
        By creating an account, you agree to our
        <a href="/pages/terms" class="register-form__link">Terms of Service</a>
        and
        <a href="/pages/privacy" class="register-form__link">Privacy Policy</a>.
      </div>
    </div>
  </div>
</div>

<style>
  .register-page {
    padding: 120px 1rem 4rem;
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: var(--color-muted, #F5F5F4);
  }

  .register-page__inner {
    width: 100%;
    max-width: 480px;
  }

  .register-form {
    background: white;
    padding: 2.5rem;
    border: 1px solid var(--color-border, #E7E5E4);
  }

  .register-form__header {
    text-align: center;
    margin-bottom: 2rem;
  }

  .register-form__title {
    font-family: var(--font-heading, serif);
    font-size: 1.75rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .register-form__subtitle {
    font-size: 0.875rem;
    color: var(--color-muted, #78716C);
  }

  .register-form__link {
    color: var(--color-accent, #CA8A04);
    text-decoration: none;
    font-weight: 500;
  }

  .register-form__link:hover {
    text-decoration: underline;
  }

  .register-form__errors {
    margin-bottom: 1.5rem;
    padding: 1rem;
    background-color: #FEE2E2;
    border: 1px solid #FECACA;
    color: #991B1B;
    font-size: 0.875rem;
  }

  .register-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
  }

  .register-form__field {
    margin-bottom: 1.25rem;
  }

  .register-form__label {
    display: block;
    margin-bottom: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .register-form__input {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border, #E7E5E4);
    font-size: 0.875rem;
    transition: border-color 0.2s;
  }

  .register-form__input:focus {
    outline: none;
    border-color: var(--color-accent, #CA8A04);
  }

  .register-form__input[aria-invalid="true"] {
    border-color: #DC2626;
  }

  .register-form__hint {
    margin-top: 0.5rem;
    font-size: 0.75rem;
    color: var(--color-muted, #78716C);
  }

  .register-form__consent {
    margin-bottom: 1.5rem;
  }

  .register-form__checkbox {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    cursor: pointer;
    font-size: 0.875rem;
    color: var(--color-muted, #78716C);
  }

  .register-form__checkbox input {
    margin-top: 0.25rem;
  }

  .register-form__button {
    width: 100%;
    padding: 0.875rem;
    background-color: var(--color-foreground, #0C0A09);
    color: var(--color-background, #FAFAF9);
    border: none;
    font-size: 0.875rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .register-form__button:hover {
    opacity: 0.9;
  }

  .register-form__terms {
    margin-top: 1.5rem;
    font-size: 0.75rem;
    color: var(--color-muted, #78716C);
    text-align: center;
  }
</style>

{% schema %}
{
  "name": "Register Page",
  "tag": "section",
  "class": "section-register",
  "settings": [],
  "presets": [
    {
      "name": "Register Page"
    }
  ]
}
{% endschema %}
