<div class="bg-foreground text-background font-sans" id="AnnouncementBar-{{ section.id }}">
  <div class="mx-auto flex max-w-7xl items-center justify-center gap-4 px-6 py-2.5 text-[10px] uppercase tracking-[0.24em]">
    <span class="opacity-60 hidden sm:block">—</span>
    <span class="opacity-85 text-center flex items-center justify-center">
      {% content_for 'blocks' %}
    </span>
    <span class="opacity-60 hidden sm:block">—</span>
    
    <div class="hidden items-center gap-6 md:flex ml-auto md:ml-0 md:absolute md:right-6">
      {%- if section.settings.secondary_menu != blank -%}
        {%- for link in linklists[section.settings.secondary_menu].links -%}
          <a href="{{ link.url }}" class="opacity-55 hover:opacity-100 transition-opacity duration-200">
            {{ link.title }}
          </a>
          {%- unless forloop.last -%}
            <span class="opacity-30">|</span>
          {%- endunless -%}
        {%- endfor -%}
      {%- else -%}
        <a href="/apps/track-order" class="opacity-55 hover:opacity-100 transition-opacity duration-200">Track</a>
        <span class="opacity-30">|</span>
        <a href="/pages/stores" class="opacity-55 hover:opacity-100 transition-opacity duration-200">Stores</a>
        <span class="opacity-30">|</span>
        <a href="#" class="opacity-55 hover:opacity-100 transition-opacity duration-200">EN · USD</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement Bar (KENZ)",
  "tag": "aside",
  "class": "shopify-section-announcement-bar-kenz",
  "settings": [
    {
      "type": "link_list",
      "id": "secondary_menu",
      "label": "Secondary Menu (Right Side)",
      "info": "Leave blank to display default links (Track, Stores, EN · USD)"
    }
  ],
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar (KENZ)",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}
