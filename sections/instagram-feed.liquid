{%- comment -%}
  sections/instagram-feed.liquid
  Instagram feed gallery section
{%- endcomment -%}

<div
  class="instagram-feed"
  data-section-id="{{ section.id }}"
  data-section-type="instagram-feed"
>
  <div class="instagram-feed__inner">
    {%- if section.settings.title != blank -%}
      <div class="instagram-feed__header">
        <h2 class="instagram-feed__title">{{ section.settings.title }}</h2>
        {%- if section.settings.instagram_url != blank -%}
          <a href="{{ section.settings.instagram_url }}" class="instagram-feed__follow" target="_blank" rel="noopener noreferrer">
            Follow Us
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="instagram-feed__grid">
      {%- for block in section.blocks -%}
        <a
          href="{{ section.settings.instagram_url | default: '#' }}"
          class="instagram-feed__item"
          target="_blank"
          rel="noopener noreferrer"
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            <img
              class="instagram-feed__image"
              src="{{ block.settings.image | image_url: width: 600 }}"
              alt="{{ block.settings.image.alt | default: 'Instagram' }}"
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}"
              loading="lazy"
            >
          {%- else -%}
            <div class="instagram-feed__placeholder">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {%- endif -%}

          <div class="instagram-feed__overlay">
            <svg class="instagram-feed__icon" viewBox="0 0 24 24" fill="none">
              <rect x="2" y="2" width="20" height="20" rx="5" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="12" cy="12" r="5" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor"/>
            </svg>
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .instagram-feed {
    padding: 4rem 1.5rem;
    background-color: var(--color-background, #FAFAF9);
  }

  @media (min-width: 768px) {
    .instagram-feed {
      padding: 5rem 3rem;
    }
  }

  .instagram-feed__inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  .instagram-feed__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2rem;
  }

  .instagram-feed__title {
    font-family: var(--font-heading, serif);
    font-size: 2rem;
    font-weight: 600;
  }

  .instagram-feed__follow {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent, #CA8A04);
    text-decoration: none;
  }

  .instagram-feed__follow:hover {
    text-decoration: underline;
  }

  .instagram-feed__follow svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s;
  }

  .instagram-feed__follow:hover svg {
    transform: translateX(4px);
  }

  .instagram-feed__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.5rem;
  }

  @media (min-width: 640px) {
    .instagram-feed__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 1024px) {
    .instagram-feed__grid {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  .instagram-feed__item {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background-color: var(--color-muted, #F5F5F4);
  }

  .instagram-feed__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .instagram-feed__item:hover .instagram-feed__image {
    transform: scale(1.05);
  }

  .instagram-feed__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .instagram-feed__placeholder svg {
    width: 48px;
    height: 48px;
    color: var(--color-muted, #78716C);
  }

  .instagram-feed__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: rgba(0, 0, 0, 0.4);
    opacity: 0;
    transition: opacity 0.3s;
  }

  .instagram-feed__item:hover .instagram-feed__overlay {
    opacity: 1;
  }

  .instagram-feed__icon {
    width: 32px;
    height: 32px;
    color: white;
  }
</style>

{% schema %}
{
  "name": "Instagram Feed",
  "tag": "section",
  "class": "section-instagram",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Follow Us on Instagram"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram Profile URL"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Recommended: 600x600px"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Instagram Feed",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
