{%- comment -%}
  sections/hero.liquid
  Premium hero section with image/video support
{%- endcomment -%}

<div
  class="hero {% if section.settings.full_height %}hero--full{% endif %}"
  data-section-id="{{ section.id }}"
  data-section-type="hero"
>
  {%- comment -%} Media Background {%- endcomment -%}
  <div class="hero__media">
    {%- if section.settings.video != blank -%}
      <video
        class="hero__video"
        autoplay
        loop
        muted
        playsinline
        {% if section.settings.poster != blank %}
          poster="{{ section.settings.poster | image_url: width: 1920 }}"
        {% endif %}
        aria-hidden="true"
      >
        <source src="{{ section.settings.video }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      <img
        class="hero__image"
        src="{{ section.settings.image | image_url: width: 1920 }}"
        alt="{{ section.settings.image.alt | default: section.settings.title }}"
        width="{{ section.settings.image.width }}"
        height="{{ section.settings.image.height }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- else -%}
      <div class="hero__placeholder"></div>
    {%- endif -%}

    {%- comment -%} Overlay {%- endcomment -%}
    <div
      class="hero__overlay"
      style="opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }}"
    ></div>
  </div>

  {%- comment -%} Content {%- endcomment -%}
  <div class="hero__content {% if section.settings.text_center %}hero__content--center{% endif %}">
    <div class="hero__inner">
      {%- if section.settings.subheading != blank -%}
        <p class="hero__subheading">{{ section.settings.subheading }}</p>
      {%- endif -%}

      {%- if section.settings.title != blank -%}
        <h1 class="hero__title">{{ section.settings.title }}</h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <p class="hero__description">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <div class="hero__buttons">
          <a
            href="{{ section.settings.button_url | default: '#' }}"
            class="hero__button hero__button--primary"
          >
            {{ section.settings.button_label }}
            <svg class="hero__button-icon" viewBox="0 0 24 24" fill="none">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          {%- if section.settings.button_label_2 != blank -%}
            <a
              href="{{ section.settings.button_url_2 | default: '#' }}"
              class="hero__button hero__button--secondary"
            >
              {{ section.settings.button_label_2 }}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Scroll Indicator {%- endcomment -%}
  {%- if section.settings.show_scroll -%}
    <div class="hero__scroll">
      <span class="hero__scroll-text">Scroll</span>
      <svg class="hero__scroll-icon" viewBox="0 0 24 24" fill="none">
        <path d="M12 5V19M5 12L12 19L19 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </div>
  {%- endif -%}
</div>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background-color: var(--color-foreground, #0C0A09);
  }

  .hero--full {
    min-height: 100vh;
  }

  /* Media */
  .hero__media {
    position: absolute;
    inset: 0;
  }

  .hero__image,
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hero__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(
      135deg,
      var(--color-foreground, #0C0A09) 0%,
      var(--color-secondary, #44403C) 100%
    );
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--color-foreground, #0C0A09);
  }

  /* Content */
  .hero__content {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    min-height: 60vh;
    padding: 6rem 1.5rem 4rem;
    color: var(--color-background, #FAFAF9);
  }

  .hero--full .hero__content {
    min-height: 100vh;
  }

  @media (min-width: 768px) {
    .hero__content {
      padding: 8rem 3rem 5rem;
    }
  }

  .hero__content--center {
    justify-content: center;
    text-align: center;
  }

  .hero__inner {
    max-width: 800px;
  }

  .hero__content--center .hero__inner {
    margin: 0 auto;
  }

  /* Typography */
  .hero__subheading {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin-bottom: 1rem;
    opacity: 0.8;
  }

  .hero__title {
    font-family: var(--font-heading, serif);
    font-size: 3rem;
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: 1.5rem;
  }

  @media (min-width: 768px) {
    .hero__title {
      font-size: 4.5rem;
    }
  }

  .hero__description {
    font-size: 1.125rem;
    line-height: 1.6;
    margin-bottom: 2rem;
    max-width: 500px;
    opacity: 0.9;
  }

  .hero__content--center .hero__description {
    margin-left: auto;
    margin-right: auto;
  }

  /* Buttons */
  .hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .hero__content--center .hero__buttons {
    justify-content: center;
  }

  .hero__button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 1rem 2rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .hero__button--primary {
    background-color: var(--color-background, #FAFAF9);
    color: var(--color-foreground, #0C0A09);
  }

  .hero__button--primary:hover {
    background-color: var(--color-accent, #CA8A04);
    color: var(--color-background, #FAFAF9);
  }

  .hero__button--secondary {
    background-color: transparent;
    color: var(--color-background, #FAFAF9);
    border: 1px solid currentColor;
  }

  .hero__button--secondary:hover {
    background-color: var(--color-background, #FAFAF9);
    color: var(--color-foreground, #0C0A09);
  }

  .hero__button-icon {
    width: 16px;
    height: 16px;
    transition: transform 0.3s ease;
  }

  .hero__button:hover .hero__button-icon {
    transform: translateX(4px);
  }

  /* Scroll Indicator */
  .hero__scroll {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-background, #FAFAF9);
    opacity: 0.7;
    animation: scrollBounce 2s infinite;
  }

  @keyframes scrollBounce {
    0%, 100% { transform: translateX(-50%) translateY(0); }
    50% { transform: translateX(-50%) translateY(8px); }
  }

  .hero__scroll-text {
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }

  .hero__scroll-icon {
    width: 20px;
    height: 20px;
  }
</style>

{% schema %}
{
  "name": "Hero",
  "tag": "section",
  "class": "section-hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image",
      "info": "Recommended: 1920x1080px"
    },
    {
      "type": "text",
      "id": "video",
      "label": "Video URL",
      "info": "MP4 format recommended"
    },
    {
      "type": "image_picker",
      "id": "poster",
      "label": "Video Poster",
      "info": "Displayed while video loads"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30,
      "unit": "%"
    },
    {
      "type": "checkbox",
      "id": "full_height",
      "label": "Full Height",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "New Collection"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "Discover Your Style"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "checkbox",
      "id": "text_center",
      "label": "Center Text",
      "default": false
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop Now"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second Button Label"
    },
    {
      "type": "url",
      "id": "button_url_2",
      "label": "Second Button URL"
    },
    {
      "type": "header",
      "content": "Scroll"
    },
    {
      "type": "checkbox",
      "id": "show_scroll",
      "label": "Show Scroll Indicator",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "settings": {
        "title": "Discover Your Style",
        "description": "Explore our curated collection of premium fashion pieces.",
        "button_label": "Shop Now"
      }
    }
  ]
}
{% endschema %}
