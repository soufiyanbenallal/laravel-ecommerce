{%- comment -%}
  sections/collection-list.liquid
  Feature multiple collections in a grid
{%- endcomment -%}

<div
  class="collection-list"
  data-section-id="{{ section.id }}"
  data-section-type="collection-list"
>
  <div class="collection-list__inner">
    {%- comment -%} Header {%- endcomment -%}
    {%- if section.settings.title != blank -%}
      <div class="collection-list__header">
        <h2 class="collection-list__title">{{ section.settings.title }}</h2>
        {%- if section.settings.description != blank -%}
          <p class="collection-list__description">{{ section.settings.description }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- comment -%} Grid {%- endcomment -%}
    <div class="collection-list__grid">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        <a
          href="{{ collection.url | default: '#' }}"
          class="collection-list__item"
          {{ block.shopify_attributes }}
        >
          <div class="collection-list__image-wrapper">
            {%- if collection.image != blank -%}
              <img
                class="collection-list__image"
                src="{{ collection.image | image_url: width: 800 }}"
                alt="{{ collection.image.alt | default: collection.title }}"
                width="{{ collection.image.width }}"
                height="{{ collection.image.height }}"
                loading="lazy"
              >
            {%- elsif collection.products.first.image != blank -%}
              <img
                class="collection-list__image"
                src="{{ collection.products.first.image | image_url: width: 800 }}"
                alt="{{ collection.title }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="collection-list__placeholder">
                {{ 'collection-1' | placeholder_svg_tag }}
              </div>
            {%- endif -%}

            <div class="collection-list__overlay"></div>
          </div>

          <div class="collection-list__content">
            <h3 class="collection-list__item-title">
              {{ block.settings.title | default: collection.title | default: 'Collection' }}
            </h3>
            {%- if block.settings.show_count -%}
              <span class="collection-list__count">
                {{ collection.products_count | default: 0 }} Products
              </span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .collection-list {
    padding: 4rem 1.5rem;
    background-color: var(--color-background, #FAFAF9);
  }

  @media (min-width: 768px) {
    .collection-list {
      padding: 6rem 3rem;
    }
  }

  .collection-list__inner {
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Header */
  .collection-list__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .collection-list__title {
    font-family: var(--font-heading, serif);
    font-size: 2.5rem;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .collection-list__title {
      font-size: 3rem;
    }
  }

  .collection-list__description {
    margin-top: 1rem;
    color: var(--color-muted, #78716C);
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Grid */
  .collection-list__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .collection-list__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.5rem;
    }
  }

  @media (min-width: 1024px) {
    .collection-list__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  /* Item */
  .collection-list__item {
    position: relative;
    display: block;
    aspect-ratio: 3/4;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
  }

  @media (min-width: 768px) {
    .collection-list__item {
      aspect-ratio: 4/5;
    }
  }

  .collection-list__image-wrapper {
    position: absolute;
    inset: 0;
    background-color: var(--color-muted, #F5F5F4);
  }

  .collection-list__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .collection-list__item:hover .collection-list__image {
    transform: scale(1.05);
  }

  .collection-list__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .collection-list__placeholder svg {
    width: 60px;
    height: 60px;
    color: var(--color-muted, #78716C);
  }

  .collection-list__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(0, 0, 0, 0.5) 0%,
      rgba(0, 0, 0, 0) 50%
    );
  }

  /* Content */
  .collection-list__content {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    padding: 1.5rem;
    color: var(--color-background, #FAFAF9);
  }

  .collection-list__item-title {
    font-family: var(--font-heading, serif);
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  @media (min-width: 768px) {
    .collection-list__item-title {
      font-size: 1.5rem;
    }
  }

  .collection-list__count {
    font-size: 0.75rem;
    opacity: 0.8;
  }
</style>

{% schema %}
{
  "name": "Collection List",
  "tag": "section",
  "class": "section-collection-list",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Shop by Category"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "checkbox",
          "id": "show_count",
          "label": "Show Product Count",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection List",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}
