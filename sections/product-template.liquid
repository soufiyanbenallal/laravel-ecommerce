{%- comment -%}
  sections/product-template.liquid
  Product page with full functionality
{%- endcomment -%}

<div
  class="product-page"
  data-section-id="{{ section.id }}"
  data-section-type="product-template"
>
  <div class="product-page__inner">
    {%- comment -%} Breadcrumb {%- endcomment -%}
    <nav class="product-page__breadcrumb" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">Home</a></li>
        {%- if collection -%}
          <li><a href="{{ collection.url }}">{{ collection.title }}</a></li>
        {%- endif -%}
        <li aria-current="page">{{ product.title }}</li>
      </ol>
    </nav>

    <div class="product-page__grid">
      {%- comment -%} Product Gallery {%- endcomment -%}
      <div class="product-page__gallery">
        <div class="product-page__main-image" id="main-image">
          {%- if product.featured_image -%}
            <img
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.featured_image.alt | default: product.title }}"
              width="{{ product.featured_image.width }}"
              height="{{ product.featured_image.height }}"
              id="product-main-img"
            >
          {%- else -%}
            <div class="product-page__no-image">
              {{ 'product-1' | placeholder_svg_tag }}
            </div>
          {%- endif -%}
        </div>

        {%- if product.images.size > 1 -%}
          <div class="product-page__thumbnails">
            {%- for image in product.images -%}
              <button
                class="product-page__thumbnail {% if forloop.first %}is-active{% endif %}"
                data-image="{{ image | image_url: width: 1200 }}"
                data-alt="{{ image.alt | default: product.title }}"
                aria-label="View image {{ forloop.index }}"
              >
                <img
                  src="{{ image | image_url: width: 100 }}"
                  alt="{{ image.alt | default: product.title }}"
                  width="60"
                  height="60"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} Product Info {%- endcomment -%}
      <div class="product-page__info">
        {%- if product.vendor != blank -%}
          <p class="product-page__vendor">{{ product.vendor }}</p>
        {%- endif -%}

        <h1 class="product-page__title">{{ product.title }}</h1>

        {%- comment -%} Price {%- endcomment -%}
        <div class="product-page__price">
          {%- if product.compare_at_price > product.price -%}
            <span class="product-page__price--compare">{{ product.compare_at_price | money }}</span>
          {%- endif -%}
          <span class="product-page__price--current">{{ product.price | money }}</span>
        </div>

        {%- comment -%} Description {%- endcomment -%}
        {%- if product.description != blank -%}
          <div class="product-page__description">
            {{ product.description }}
          </div>
        {%- endif -%}

        {%- comment -%} Variant Selection {%- endcomment -%}
        {%- form 'product', product, id: 'product-form' -%}
          {%- if product.variants.size > 1 -%}
            <div class="product-page__variants">
              <label class="product-page__label" for="variant-select">
                {{ product.options[0].name }}
                {%- if product.selected_variant -%}
                  : {{ product.selected_variant.title }}
                {%- endif -%}
              </label>
              <select
                id="variant-select"
                name="id"
                class="product-page__select"
                data-product-url="{{ product.url }}"
              >
                {%- for variant in product.variants -%}
                  <option
                    value="{{ variant.id }}"
                    {% if variant == product.selected_variant %}selected{% endif %}
                    {% unless variant.available %}disabled{% endunless %}
                  >
                    {{ variant.title }}
                    {%- unless variant.available %} - {{ 'products.product.sold_out' | t }}{% endunless %}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ product.variants.first.id }}">
          {%- endif -%}

          {%- comment -%} Quantity {%- endcomment -%}
          <div class="product-page__quantity">
            <label class="product-page__label" for="quantity">Quantity</label>
            <div class="product-page__quantity-selector">
              <button type="button" class="product-page__quantity-btn" data-action="minus" aria-label="Decrease quantity">-</button>
              <input type="number" id="quantity" name="quantity" value="1" min="1" class="product-page__quantity-input">
              <button type="button" class="product-page__quantity-btn" data-action="plus" aria-label="Increase quantity">+</button>
            </div>
          </div>

          {%- comment -%} Add to Cart {%- endcomment -%}
          <button
            type="submit"
            class="product-page__add-to-cart"
            {% unless product.available %}disabled{% endunless %}
          >
            {%- if product.available -%}
              {{ 'products.product.add_to_cart' | t }}
            {%- else -%}
              {{ 'products.product.sold_out' | t }}
            {%- endif -%}
          </button>
        {%- endform -%}

        {%- comment -%} Trust Badges {%- endcomment -%}
        <div class="product-page__trust">
          <div class="product-page__trust-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M12 22C12 22 20 18 20 12V5L12 2L4 5V12C4 18 12 22 12 22Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Secure Checkout</span>
          </div>
          <div class="product-page__trust-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M5 12H19M19 12L12 5M19 12L12 19" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Free Shipping Over $150</span>
          </div>
          <div class="product-page__trust-item">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
              <path d="M4 4H20C21.1 4 22 4.9 22 6V18C22 19.1 21.1 20 20 20H4C2.9 20 2 19.1 2 18V6C2 4.9 2.9 4 4 4Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M22 6L12 13L2 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>30-Day Returns</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Thumbnail gallery
    const thumbnails = document.querySelectorAll('.product-page__thumbnail');
    const mainImage = document.getElementById('product-main-img');

    thumbnails.forEach(function(thumb) {
      thumb.addEventListener('click', function() {
        thumbnails.forEach(function(t) { t.classList.remove('is-active'); });
        this.classList.add('is-active');
        if (mainImage) {
          mainImage.src = this.dataset.image;
          mainImage.alt = this.dataset.alt;
        }
      });
    });

    // Quantity selector
    const quantityInput = document.getElementById('quantity');
    document.querySelectorAll('.product-page__quantity-btn').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var action = this.dataset.action;
        var current = parseInt(quantityInput.value) || 1;
        if (action === 'plus') {
          quantityInput.value = current + 1;
        } else if (action === 'minus' && current > 1) {
          quantityInput.value = current - 1;
        }
      });
    });

    // Variant selector
    var variantSelect = document.getElementById('variant-select');
    if (variantSelect) {
      variantSelect.addEventListener('change', function() {
        var selectedOption = this.options[this.selectedIndex];
        var url = this.dataset.productUrl;
        if (url) {
          window.location.href = url + '?variant=' + this.value;
        }
      });
    }
  });
</script>

<style>
  .product-page {
    padding-top: 80px;
    padding-bottom: 4rem;
  }

  @media (min-width: 768px) {
    .product-page {
      padding-top: 100px;
    }
  }

  .product-page__inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  @media (min-width: 768px) {
    .product-page__inner {
      padding: 0 2rem;
    }
  }

  /* Breadcrumb */
  .product-page__breadcrumb {
    margin-bottom: 1.5rem;
    font-size: 0.75rem;
    color: var(--color-muted, #78716C);
  }

  .product-page__breadcrumb ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .product-page__breadcrumb li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .product-page__breadcrumb li:not(:last-child)::after {
    content: '/';
  }

  .product-page__breadcrumb a {
    color: var(--color-muted, #78716C);
    text-decoration: none;
  }

  .product-page__breadcrumb a:hover {
    color: var(--color-foreground, #0C0A09);
  }

  /* Grid */
  .product-page__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .product-page__grid {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  /* Gallery */
  .product-page__gallery {
    position: sticky;
    top: 100px;
    align-self: start;
  }

  .product-page__main-image {
    aspect-ratio: 3/4;
    overflow: hidden;
    background-color: var(--color-muted, #F5F5F4);
    margin-bottom: 1rem;
  }

  .product-page__main-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-page__no-image {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-muted, #78716C);
  }

  .product-page__no-image svg {
    width: 80px;
    height: 80px;
  }

  .product-page__thumbnails {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
  }

  .product-page__thumbnail {
    flex-shrink: 0;
    width: 60px;
    height: 60px;
    padding: 0;
    border: 2px solid transparent;
    background: none;
    cursor: pointer;
    opacity: 0.6;
    transition: all 0.2s;
  }

  .product-page__thumbnail:hover {
    opacity: 1;
  }

  .product-page__thumbnail.is-active {
    border-color: var(--color-foreground, #0C0A09);
    opacity: 1;
  }

  .product-page__thumbnail img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Info */
  .product-page__vendor {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-muted, #78716C);
    margin-bottom: 0.5rem;
  }

  .product-page__title {
    font-family: var(--font-heading, serif);
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  @media (min-width: 768px) {
    .product-page__title {
      font-size: 2rem;
    }
  }

  .product-page__price {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .product-page__price--current {
    font-size: 1.25rem;
    font-weight: 600;
  }

  .product-page__price--compare {
    font-size: 1rem;
    color: var(--color-muted, #78716C);
    text-decoration: line-through;
  }

  .product-page__description {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-muted, #78716C);
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border, #E7E5E4);
  }

  .product-page__label {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }

  .product-page__variants {
    margin-bottom: 1.5rem;
  }

  .product-page__select {
    width: 100%;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border, #E7E5E4);
    background-color: white;
    font-size: 0.875rem;
    appearance: none;
    cursor: pointer;
  }

  .product-page__select:focus {
    outline: none;
    border-color: var(--color-accent, #CA8A04);
  }

  .product-page__quantity {
    margin-bottom: 1.5rem;
  }

  .product-page__quantity-selector {
    display: flex;
    width: fit-content;
    border: 1px solid var(--color-border, #E7E5E4);
  }

  .product-page__quantity-btn {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: none;
    font-size: 1rem;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .product-page__quantity-btn:hover {
    background-color: var(--color-muted, #F5F5F4);
  }

  .product-page__quantity-input {
    width: 60px;
    height: 40px;
    text-align: center;
    border: none;
    border-left: 1px solid var(--color-border, #E7E5E4);
    border-right: 1px solid var(--color-border, #E7E5E4);
    font-size: 0.875rem;
    -moz-appearance: textfield;
  }

  .product-page__quantity-input::-webkit-outer-spin-button,
  .product-page__quantity-input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .product-page__add-to-cart {
    width: 100%;
    padding: 1rem;
    background-color: var(--color-foreground, #0C0A09);
    color: var(--color-background, #FAFAF9);
    border: none;
    font-size: 0.9375rem;
    font-weight: 500;
    cursor: pointer;
    transition: opacity 0.2s;
    margin-bottom: 1.5rem;
  }

  .product-page__add-to-cart:hover:not(:disabled) {
    opacity: 0.9;
  }

  .product-page__add-to-cart:disabled {
    background-color: var(--color-muted, #78716C);
    cursor: not-allowed;
  }

  /* Trust */
  .product-page__trust {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border, #E7E5E4);
  }

  .product-page__trust-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--color-muted, #78716C);
  }

  .product-page__trust-item svg {
    flex-shrink: 0;
    color: var(--color-accent, #CA8A04);
  }
</style>

{% schema %}
{
  "name": "Product Template",
  "tag": "section",
  "class": "section-product",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show Vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show Description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_trust_badges",
      "label": "Show Trust Badges",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Product Template"
    }
  ]
}
{% endschema %}
