{%- comment -%}
  sections/product-recommendations.liquid
{%- endcomment -%}

<div
  class="product-recommendations"
  data-section-id="{{ section.id }}"
  data-section-type="product-recommendations"
>
  <div class="product-recommendations__inner">
    <product-carousel
      data-product-id="{{ product.id }}"
      data-limit="{{ section.settings.limit }}"
      data-title="{{ section.settings.title }}"
      data-intent="{{ section.settings.intent }}"
    ></product-carousel>
  </div>
</div>

<script>
  class ProductRecommendations extends HTMLElement {
    constructor() {
      super();
      this.productId = this.dataset.productId;
      this.limit = parseInt(this.dataset.limit) || 4;
      this.title = this.dataset.title || 'You May Also Like';
      this.intent = this.dataset.intent || 'related';
      this.loadRecommendations();
    }

    async loadRecommendations() {
      try {
        const response = await fetch(
          `/recommendations/products.json?product_id=${this.productId}&limit=${this.limit}&intent=${this.intent}`
        );
        const data = await response.json();
        if (data.products && data.products.length > 0) {
          this.render(data.products);
        }
      } catch (error) {
        console.error('Failed to load recommendations:', error);
      }
    }

    render(products) {
      const html = `
        <div class="recommendations-header">
          <h2 class="recommendations-title">${this.title}</h2>
        </div>
        <div class="recommendations-grid">
          ${products.map(product => `
            <div class="recommendation-card">
              <a href="/products/${product.handle}" class="recommendation-card__image">
                ${product.featured_image ? `
                  <img src="${product.featured_image}" alt="${product.title}" loading="lazy">
                ` : ''}
              </a>
              <div class="recommendation-card__info">
                <h3 class="recommendation-card__title">
                  <a href="/products/${product.handle}">${product.title}</a>
                </h3>
                <p class="recommendation-card__price">$${product.price}</p>
              </div>
            </div>
          `).join('')}
        </div>
      `;
      this.innerHTML = html;
    }
  }

  customElements.define('product-recommendations', ProductRecommendations);
</script>

<style>
  .product-recommendations {
    padding: 3rem 1rem;
  }

  @media (min-width: 768px) {
    .product-recommendations {
      padding: 4rem 2rem;
    }
  }

  .product-recommendations__inner {
    max-width: 1440px;
    margin: 0 auto;
  }

  .recommendations-header {
    margin-bottom: 1.5rem;
  }

  .recommendations-title {
    font-family: var(--font-heading, serif);
    font-size: 1.75rem;
    font-weight: 600;
  }

  .recommendations-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (min-width: 768px) {
    .recommendations-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  .recommendation-card__image {
    display: block;
    aspect-ratio: 3/4;
    overflow: hidden;
    background: var(--color-muted, #F5F5F4);
    margin-bottom: 0.75rem;
  }

  .recommendation-card__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .recommendation-card__image:hover img {
    transform: scale(1.05);
  }

  .recommendation-card__title {
    font-size: 0.875rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }

  .recommendation-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .recommendation-card__title a:hover {
    color: var(--color-accent, #CA8A04);
  }

  .recommendation-card__price {
    font-size: 0.875rem;
    font-weight: 500;
  }
</style>

{% schema %}
{
  "name": "Product Recommendations",
  "tag": "section",
  "class": "section-recommendations",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "You May Also Like"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "Number of products",
      "min": 2,
      "max": 12,
      "default": 4,
      "step": 1
    },
    {
      "type": "select",
      "id": "intent",
      "label": "Recommendation Type",
      "options": [
        { "value": "related", "label": "Related Products" },
        { "value": "complementary", "label": "Complementary Products" }
      ],
      "default": "related"
    }
  ],
  "presets": [
    {
      "name": "Product Recommendations"
    }
  ]
}
{% endschema %}
