<section class="mx-auto max-w-7xl px-6 py-16" id="CollectionsGrid-{{ section.id }}">
  <div class="flex items-end justify-between gap-6 mb-12">
    <div>
      <div class="flex items-baseline gap-3 mb-3">
        <span class="font-display text-[11px] text-accent tracking-[0.3em]">✦</span>
        <span class="text-[10px] uppercase tracking-[0.28em] text-muted-foreground">{{ section.settings.subheading }}</span>
      </div>
      <h2 class="font-display text-4xl font-light md:text-5xl">
        {{ section.settings.heading }}
      </h2>
    </div>
    <a
      href="/collections"
      class="hidden text-[11px] uppercase tracking-[0.22em] text-foreground/55 hover:text-accent transition-colors md:inline-block cursor-pointer"
    >
      All collections &rarr;
    </a>
  </div>

  <div class="grid gap-5 md:grid-cols-3">
    {%- if section.blocks.size > 0 -%}
      {%- for block in section.blocks -%}
        {%- assign collection_url = block.settings.link_url | default: block.settings.collection.url -%}
        {%- assign collection_name = block.settings.title | default: block.settings.collection.title -%}
        {%- assign collection_desc = block.settings.description | default: block.settings.collection.description -%}
        {%- assign collection_image = block.settings.image | default: block.settings.collection.featured_image -%}

        <a
          href="{{ collection_url | default: '#' }}"
          class="group block cursor-pointer fade-up"
          style="animation-delay: {{ forloop.index0 | times: 60 }}ms;"
          {{ block.shopify_attributes }}
        >
          <div class="overflow-hidden bg-secondary relative">
            {%- if collection_image != blank -%}
              <img
                src="{{ collection_image | image_url: width: 800 }}"
                alt="{{ collection_name | escape }}"
                loading="lazy"
                class="aspect-[3/4] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
              >
            {%- else -%}
              <div class="aspect-[3/4] w-full bg-neutral-200 flex items-center justify-center text-muted-foreground">
                No Image
              </div>
            {%- endif -%}
            <!-- Index overlay -->
            <div class="absolute top-4 left-4 font-display text-[11px] tracking-[0.24em] text-background/50">
              0{{ forloop.index }}
            </div>
          </div>
          
          <div class="mt-4 flex items-start justify-between gap-2">
            <div>
              <div class="font-display text-xl font-light group-hover:text-accent transition-colors duration-300">
                {{ collection_name }}
              </div>
              <div class="mt-1 text-[12px] font-light text-muted-foreground">
                {{ collection_desc }}
              </div>
            </div>
            <!-- Arrow right icon -->
            <svg class="h-4 w-4 shrink-0 mt-1 text-muted-foreground/40 group-hover:text-accent group-hover:translate-x-0.5 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </div>
        </a>
      {%- endfor -%}
    {%- else -%}
      <!-- Default fallbacks using fallback assets -->
      {%- assign fallback_images = "cat-women.jpg,cat-men.jpg,cat-shoes.jpg" | split: "," -%}
      {%- assign fallback_names = "Women's Edit,Men's Edit,The Atelier Edit" | split: "," -%}
      {%- assign fallback_descs = "Refined silhouettes and timeless tailoring.,Structured pieces designed for daily luxury.,Limited numbered runs from our finest craftsmen." | split: "," -%}
      
      {%- for index in (0..2) -%}
        <a
          href="/collections"
          class="group block cursor-pointer fade-up"
          style="animation-delay: {{ index | times: 60 }}ms;"
        >
          <div class="overflow-hidden bg-secondary relative">
            <img
              src="{{ fallback_images[index] | asset_url }}"
              alt="{{ fallback_names[index] }}"
              loading="lazy"
              class="aspect-[3/4] w-full object-cover transition-transform duration-700 group-hover:scale-[1.04]"
            >
            <!-- Index overlay -->
            <div class="absolute top-4 left-4 font-display text-[11px] tracking-[0.24em] text-background/50">
              0{{ index | plus: 1 }}
            </div>
          </div>
          
          <div class="mt-4 flex items-start justify-between gap-2">
            <div>
              <div class="font-display text-xl font-light group-hover:text-accent transition-colors duration-300">
                {{ fallback_names[index] }}
              </div>
              <div class="mt-1 text-[12px] font-light text-muted-foreground">
                {{ fallback_descs[index] }}
              </div>
            </div>
            <!-- Arrow right icon -->
            <svg class="h-4 w-4 shrink-0 mt-1 text-muted-foreground/40 group-hover:text-accent group-hover:translate-x-0.5 transition-all duration-300" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
            </svg>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Collections Grid",
  "tag": "section",
  "class": "section-collections-grid",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Collections"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Edits, not seasons."
    }
  ],
  "blocks": [
    {
      "type": "collection_edit",
      "name": "Collection Edit",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom Image",
          "info": "Leave blank to use the collection's featured image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Custom Title",
          "info": "Leave blank to use the collection's title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Custom Description",
          "info": "Leave blank to use the collection's description"
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Custom URL",
          "info": "Leave blank to link directly to the collection page"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collections Grid",
      "blocks": [
        { "type": "collection_edit", "settings": { "title": "Women's Edit", "description": "Refined silhouettes and timeless tailoring." } },
        { "type": "collection_edit", "settings": { "title": "Men's Edit", "description": "Structured pieces designed for daily luxury." } },
        { "type": "collection_edit", "settings": { "title": "The Atelier Edit", "description": "Limited numbered runs from our finest craftsmen." } }
      ]
    }
  ]
}
{% endschema %}
