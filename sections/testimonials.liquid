{%- comment -%}
  sections/testimonials.liquid
  Customer testimonials carousel
{%- endcomment -%}

<div
  class="testimonials"
  data-section-id="{{ section.id }}"
  data-section-type="testimonials"
>
  <div class="testimonials__inner">
    {%- if section.settings.title != blank -%}
      <div class="testimonials__header">
        <h2 class="testimonials__title">{{ section.settings.title }}</h2>
      </div>
    {%- endif -%}

    <div class="testimonials__grid">
      {%- for block in section.blocks -%}
        <div class="testimonials__item" {{ block.shopify_attributes }}>
          <div class="testimonials__stars">
            {%- for i in (1..5) -%}
              <svg class="testimonials__star" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z"/>
              </svg>
            {%- endfor -%}
          </div>

          {%- if block.settings.quote != blank -%}
            <blockquote class="testimonials__quote">
              {{ block.settings.quote }}
            </blockquote>
          {%- endif -%}

          <div class="testimonials__author">
            {%- if block.settings.image != blank -%}
              <img
                class="testimonials__avatar"
                src="{{ block.settings.image | image_url: width: 100 }}"
                alt="{{ block.settings.author }}"
                width="{{ block.settings.image.width }}"
                height="{{ block.settings.image.height }}"
                loading="lazy"
              >
            {%- else -%}
              <div class="testimonials__avatar-placeholder">
                {{ block.settings.author | slice: 0 }}
              </div>
            {%- endif -%}

            <div class="testimonials__author-info">
              <span class="testimonials__author-name">{{ block.settings.author }}</span>
              {%- if block.settings.title != blank -%}
                <span class="testimonials__author-title">{{ block.settings.title }}</span>
              {%- endif -%}
            </div>
          </div>

          {%- if block.settings.verified -%}
            <div class="testimonials__verified">
              <svg viewBox="0 0 24 24" fill="none">
                <path d="M9 12L11 14L15 10M21 12C21 16.9706 16.9706 21 12 21C7.02944 21 3 16.9706 3 12C3 7.02944 7.02944 3 12 3C16.9706 3 21 7.02944 21 12Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
              Verified Purchase
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .testimonials {
    padding: 4rem 1.5rem;
    background-color: var(--color-muted, #F5F5F4);
  }

  @media (min-width: 768px) {
    .testimonials {
      padding: 6rem 3rem;
    }
  }

  .testimonials__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Header */
  .testimonials__header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .testimonials__title {
    font-family: var(--font-heading, serif);
    font-size: 2.5rem;
    font-weight: 600;
  }

  /* Grid */
  .testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  @media (min-width: 768px) {
    .testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* Item */
  .testimonials__item {
    background: white;
    padding: 2rem;
    display: flex;
    flex-direction: column;
  }

  .testimonials__stars {
    display: flex;
    gap: 0.125rem;
    margin-bottom: 1rem;
  }

  .testimonials__star {
    width: 16px;
    height: 16px;
    color: var(--color-accent, #CA8A04);
  }

  .testimonials__quote {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-foreground, #0C0A09);
    margin-bottom: 1.5rem;
    flex: 1;
  }

  .testimonials__author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .testimonials__avatar {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }

  .testimonials__avatar-placeholder {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background-color: var(--color-accent, #CA8A04);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 600;
    font-size: 1rem;
  }

  .testimonials__author-name {
    display: block;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .testimonials__author-title {
    display: block;
    font-size: 0.75rem;
    color: var(--color-muted, #78716C);
  }

  .testimonials__verified {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border, #E7E5E4);
    font-size: 0.75rem;
    color: var(--color-muted, #78716C);
  }

  .testimonials__verified svg {
    width: 14px;
    height: 14px;
    color: #16A34A;
  }
</style>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "What Our Customers Say"
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Absolutely love this piece! The quality is exceptional and it fits perfectly."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author Name",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title/Location"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Author Photo"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Verified Purchase",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial" },
        { "type": "testimonial" },
        { "type": "testimonial" }
      ]
    }
  ]
}
{% endschema %}
