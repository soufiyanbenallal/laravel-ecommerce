<section class="border-y border-border/40 py-20 bg-background" id="Testimonials-{{ section.id }}">
  <div class="mx-auto max-w-7xl px-6">
    <div class="flex items-baseline gap-3 mb-3">
      <span class="font-display text-[11px] text-accent tracking-[0.3em]">✦</span>
      <span class="text-[10px] uppercase tracking-[0.28em] text-muted-foreground">{{ section.settings.subheading }}</span>
    </div>
    <h2 class="font-display text-4xl font-light md:text-5xl mb-12">
      {{ section.settings.heading }}
    </h2>

    <div class="grid gap-8 md:grid-cols-3">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <div class="flex flex-col justify-between border-b border-border/40 pb-8 md:border-b-0 md:border-r md:border-border/30 md:pb-0 md:pr-8 last:border-0 last:pr-0" {{ block.shopify_attributes }}>
            <div>
              <div class="flex gap-0.5 text-accent mb-4">
                {%- for i in (1..5) -%}
                  <svg class="h-3 w-3 fill-current" viewBox="0 0 24 24" stroke-width="0">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                  </svg>
                {%- endfor -%}
              </div>
              <blockquote class="font-display text-lg font-light leading-relaxed italic text-foreground/80">
                "{{ block.settings.quote }}"
              </blockquote>
            </div>
            <div class="mt-6">
              <p class="text-[12px] font-medium uppercase tracking-[0.16em] text-foreground">{{ block.settings.author }}</p>
              <p class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground mt-1">Verified Buyer · {{ block.settings.product_name }}</p>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Fallbacks -->
        {%- assign fallback_quotes = "The wool overcoat is a masterpiece. The weight, the drape, the stitching—it rivals coats three times the price.,KENZ has completely changed how I buy. I have three of their shirts now, and they look better after a year of wear than when they arrived.,The lifetime repair service is real. They fixed a snag in my cashmere sweater within a week. Outstanding commitment." | split: "," -%}
        {%- assign fallback_authors = "Marcus K., Berlin,Elena R., Milan,Thomas S., London" | split: "," -%}
        {%- assign fallback_products = "Double-Breasted Wool Coat,Artisan Linen Shirt,Artisan Knit Sweater" | split: "," -%}
        
        {%- for index in (0..2) -%}
          <div class="flex flex-col justify-between border-b border-border/40 pb-8 md:border-b-0 md:border-r md:border-border/30 md:pb-0 md:pr-8 last:border-0 last:pr-0">
            <div>
              <div class="flex gap-0.5 text-accent mb-4">
                {%- for i in (1..5) -%}
                  <svg class="h-3 w-3 fill-current" viewBox="0 0 24 24" stroke-width="0">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" />
                  </svg>
                {%- endfor -%}
              </div>
              <blockquote class="font-display text-lg font-light leading-relaxed italic text-foreground/80">
                "{{ fallback_quotes[index] }}"
              </blockquote>
            </div>
            <div class="mt-6">
              <p class="text-[12px] font-medium uppercase tracking-[0.16em] text-foreground">{{ fallback_authors[index] }}</p>
              <p class="text-[10px] uppercase tracking-[0.2em] text-muted-foreground mt-1">Verified Buyer · {{ fallback_products[index] }}</p>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "class": "section-testimonials",
  "settings": [
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "The Experience"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Worn. Kept. Repaired."
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial Block",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The wool overcoat is a masterpiece. The weight, the drape, the stitching—it rivals coats three times the price."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Marcus K., Berlin"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product Referenced",
          "default": "Double-Breasted Wool Coat"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "quote": "The wool overcoat is a masterpiece. The weight, the drape, the stitching—it rivals coats three times the price.", "author": "Marcus K., Berlin", "product_name": "Double-Breasted Wool Coat" } },
        { "type": "testimonial", "settings": { "quote": "KENZ has completely changed how I buy. I have three of their shirts now, and they look better after a year of wear than when they arrived.", "author": "Elena R., Milan", "product_name": "Artisan Linen Shirt" } },
        { "type": "testimonial", "settings": { "quote": "The lifetime repair service is real. They fixed a snag in my cashmere sweater within a week. Outstanding commitment.", "author": "Thomas S., London", "product_name": "Artisan Knit Sweater" } }
      ]
    }
  ]
}
{% endschema %}
