{
  "name": "kenz-maison-shopify-theme",
  "version": "1.0.0",
  "description": "KENZ Maison - Premium Shopify Theme",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && pnpm run build:css",
    "build:css": "npx @tailwindcss/cli -i src/app.css -o assets/app.css --minify",
    "preview": "vite preview",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "biome format --write src",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "push": "shopify theme push --store wevente.myshopify.com --theme 161373585661 --password shptka_7032c0e6d70c419670c4fac14878c769 --allow-live",
    "pull": "shopify theme pull --store wevente.myshopify.com --theme 161373585661 --password shptka_7032c0e6d70c419670c4fac14878c769",
    "prepare": "husky"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@tanstack/react-virtual": "^3.10.0",
    "@types/three": "^0.185.0",
    "clsx": "^2.1.0",
    "embla-carousel-react": "^8.5.0",
    "motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.185.0",
    "zod": "^3.24.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/cli": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/ui": "^3.0.0",
    "eslint": "^9.0.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "biome format --write"
    ],
    "*.{json,css,md}": [
      "biome format --write"
    ]
  }
}
