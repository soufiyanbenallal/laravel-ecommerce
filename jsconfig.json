{
    "compilerOptions": {
        "checkJs": false,
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "Bundler",
        "baseUrl": ".",
        "paths": {
            "~/*": ["hydrogen-quickstart/app/*"]
        }
    },
    "include": [
        "env.d.ts",
        "hydrogen-quickstart/app/**/*.js",
        "hydrogen-quickstart/app/**/*.jsx",
        "hydrogen-quickstart/app/**/*.d.ts",
        "*.js",
        "*.jsx",
        "*.d.ts",
        ".graphqlrc.js",
        ".react-router/types/**/*"
    ]
}
