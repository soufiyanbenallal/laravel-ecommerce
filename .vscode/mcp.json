{
  "servers": {
    "shadcn": {
      "command": "npx",
      "args": [
        "shadcn@latest",
        "mcp"
      ]
    },
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "/Users/user/Documents/AS/laravel-ecommerce"
      ]
    },
    "mysql": {
      "command": "npx",
      "type": "stdio",
      "args": [
        "-y",
         "@berthojoris/mcp-mysql-server",
        "mysql://sail:password@127.0.0.1:3306/laravel",
        "list,read,utility"
      ],
      "env": {
        "DB_HOST": "127.0.0.1",
        "DB_PORT": "3306",
        "DB_USER": "sail",
        "DB_PASSWORD": "password",
        "DB_NAME": "laravel",
        "MCP_PERMISSIONS": "list,read,utility"
      }
    }
  }
}
