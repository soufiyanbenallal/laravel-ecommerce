<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">

  <title>{{ 'general.password_page.opening_soon' | t }} &ndash; {{ shop.name }}</title>

  {{ content_for_header }}

  {{ 'app.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
  </script>
</head>

<body class="password-page">
  <main role="main" id="MainContent">
    {{ content_for_layout }}
    <div class="password-page__content">
      <header class="password-page__header">
        {%- if settings.logo != blank -%}
          <img
            src="{{ settings.logo | image_url: width: 200 }}"
            alt="{{ shop.name }}"
            class="password-page__logo"
            width="{{ settings.logo.width }}"
            height="{{ settings.logo.height }}"
            loading="eager"
          >
        {%- else -%}
          <h1 class="password-page__title">{{ shop.name }}</h1>
        {%- endif -%}

        <p class="password-page__subtitle">{{ 'general.password_page.opening_soon' | t }}</p>
      </header>

      <div class="password-page__form">
        {%- form 'storefront_password' -%}
          {%- if form.errors -%}
            <div class="password-page__error">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="password-page__input-group">
            <label for="Password" class="visually-hidden">
              {{ 'general.password_page.password_label' | t }}
            </label>
            <input
              type="password"
              name="password"
              id="Password"
              class="password-page__input"
              placeholder="{{ 'general.password_page.password_placeholder' | t }}"
              autocomplete="current-password"
              {%- if form.errors -%}
                aria-invalid="true"
              {%- endif -%}
            >
            <button type="submit" class="password-page__button">
              {{ 'general.password_page.submit' | t }}
            </button>
          </div>
        {%- endform -%}
      </div>

      <footer class="password-page__footer">
        <p class="password-page__footer-text">
          {{ powered_by_link }}
        </p>
      </footer>
    </div>
  </main>

  <style>
    .password-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background-color: var(--color-background, #FAFAF9);
    }

    .password-page__content {
      width: 100%;
      max-width: 400px;
      padding: 2rem;
      text-align: center;
    }

    .password-page__header {
      margin-bottom: 3rem;
    }

    .password-page__logo {
      max-width: 150px;
      margin: 0 auto 1.5rem;
    }

    .password-page__title {
      font-family: var(--font-heading, serif);
      font-size: 2rem;
      font-weight: 600;
      margin-bottom: 0.5rem;
    }

    .password-page__subtitle {
      color: var(--color-muted, #78716C);
    }

    .password-page__error {
      margin-bottom: 1rem;
      padding: 1rem;
      background-color: #FEE2E2;
      border-radius: 0.5rem;
      color: #DC2626;
      font-size: 0.875rem;
    }

    .password-page__input-group {
      display: flex;
      gap: 0.5rem;
    }

    .password-page__input {
      flex: 1;
      padding: 0.75rem 1rem;
      border: 1px solid var(--color-border, #E7E5E4);
      border-radius: 0.375rem;
      font-size: 1rem;
    }

    .password-page__button {
      padding: 0.75rem 1.5rem;
      background-color: var(--color-accent, #CA8A04);
      color: white;
      border: none;
      border-radius: 0.375rem;
      font-size: 1rem;
      font-weight: 500;
      cursor: pointer;
      transition: background-color 0.2s;
    }

    .password-page__button:hover {
      background-color: color-mix(in srgb, var(--color-accent, #CA8A04) 90%, black);
    }

    .password-page__footer {
      margin-top: 3rem;
    }

    .password-page__footer-text {
      font-size: 0.75rem;
      color: var(--color-muted, #78716C);
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  </style>
</body>
</html>
